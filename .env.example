# Kopyalayıp .env olarak kaydedin. .env dosyası git'e eklenmez.
PORT=3000
# Yönetici hesabı: her açılışta bu e-posta yönetici yapılır ve şifresi güncellenir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# test: tahsilatsız test ödemesi (geliştirme varsayılanı). none: ödeme kapalı (production varsayılanı).
PAYMENT_PROVIDER=test
# Boş bırakılırsa yerelde gömülü Postgres (PGlite, data/pg) kullanılır.
# DATABASE_URL=postgres://...
# Boş bırakılırsa fotoğraflar data/uploads klasörüne kaydedilir.
# BLOB_READ_WRITE_TOKEN=
